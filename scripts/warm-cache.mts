// Pre-warms the shared AI cache for TODAY's demo-farm plan in all five languages, so the first judge gets an instant
// answer too. Builds the plan exactly as the app does (same forecast request, same engine), then requests
// /api/instruct and /api/voice. Each language is generated by AI once; later requests are served by Vercel's CDN.
// Usage: npx tsx scripts/warm-cache.mts [https://namak-phi.vercel.app]
import { DEMO_FARM } from '../src/data/demoFarm.ts'
import { forecastUrl, parseDaily } from '../src/data/weather.ts'
import { planFarm } from '../src/engine/farm.ts'
import { LANGS } from '../src/lib/instruction.ts'
import { instructUrl, instructionPlan, voiceUrl } from '../src/lib/worker.ts'

const base = process.argv[2] ?? 'https://namak-phi.vercel.app'
const fc = await (await fetch(forecastUrl(DEMO_FARM.lat, DEMO_FARM.lon))).json()
const days = parseDaily(fc.daily).slice(1, 8)
const plan = instructionPlan(planFarm(DEMO_FARM, days))
console.log('plan for', plan.date, JSON.stringify(plan.valves.map((v) => `${v.n}:${v.minutes}m@${v.start}`)))

for (const l of LANGS) {
  let t0 = Date.now()
  const r = await fetch(base + instructUrl(plan, l.id))
  const j = (await r.json()) as { text: string; source: string }
  const tText = Date.now() - t0
  const cText = r.headers.get('x-vercel-cache') ?? '-'
  if (j.source !== 'gemini') {
    console.log(l.id, 'text not from AI (', j.source, ') — skipped voice')
    continue
  }
  t0 = Date.now()
  const v = await fetch(base + voiceUrl(j.text, l.id))
  const bytes = (await v.arrayBuffer()).byteLength
  console.log(
    l.id.padEnd(3),
    `text ${String(tText).padStart(5)} ms [${cText}]`,
    `voice ${String(Date.now() - t0).padStart(5)} ms [${v.headers.get('x-vercel-cache') ?? '-'}] ${v.status} ${bytes} B`,
  )
}
